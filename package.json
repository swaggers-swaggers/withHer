{
  "name": "studydesk",
  "productName": "StudyDesk",
  "version": "2.3.0",
  "description": "待办、学习计时、统计与日历",
  "author": "StudyDesk",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/dev-start.cjs",
    "test": "node --experimental-strip-types tests/run.cjs",
    "pack": "npm run build && node scripts/package-app.cjs dir",
    "package:win": "npm run build && node scripts/package-app.cjs win",
    "check:privacy": "node scripts/check-privacy.cjs",
    "test:portable": "node --experimental-strip-types tests/run.cjs && node tests/agent.test.cjs && node tests/chat-presentation.test.cjs && node tests/credential-vault.test.cjs && node tests/conversation.test.cjs",
    "test:smoke": "node tests/packaged-smoke.cjs",
    "install:local": "node scripts/install-local.cjs",
    "package:deb": "node scripts/package-deb.cjs",
    "test:agent": "node tests/agent.test.cjs",
    "test:chat": "node tests/agent.test.cjs && node tests/chat-presentation.test.cjs",
    "test:conversation": "node tests/conversation.test.cjs",
    "test:packaged-chat": "node tests/packaged-conversation.cjs"
  },
  "build": {
    "appId": "local.studydesk.app",
    "productName": "StudyDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/store.cjs",
      "electron/credential-vault.cjs",
      "electron/dafeyu-engine.cjs",
      "electron/agent/**/*.cjs",
      "electron/chat-presentation.cjs",
      "assets/studydesk-icon.png",
      "assets/dafeyu-avatar.png",
      "companion/persona.md",
      "companion/engine-settings.json",
      "companion/prompts-v2/*.md",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "linux": {
      "category": "Education",
      "executableName": "studydesk",
      "icon": "assets/studydesk-icon.png"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/studydesk-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "StudyDesk-${version}-${arch}-nsis.${ext}"
    },
    "portable": {
      "artifactName": "StudyDesk-${version}-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/swaggers-swaggers/withHer.git"
  }
}
